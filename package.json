{
  "name": "auction",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:status": "docker compose ps",
    "verify:commitment-protocol": "npm run build --workspace @auction/commitment && npm run verify --workspace @auction/commitment"
  }
}
