{
  "name": "auction",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:status": "docker compose ps",
    "verify:commitment-protocol": "npm run build --workspace @auction/commitment && npm run verify --workspace @auction/commitment",
    "web:dev": "npm run dev --workspace @auction/web",
    "web:build": "npm run build --workspace @auction/web",
    "web:start": "npm run start --workspace @auction/web",
    "web:lint": "npm run lint --workspace @auction/web",
    "web:typecheck": "npm run typecheck --workspace @auction/web",
    "verify:web-foundation": "npm run verify:foundation --workspace @auction/web",
    "verify:web-authentication": "npm run verify:authentication --workspace @auction/web",
    "verify:web-admin-auctions": "npm run verify:admin-auctions --workspace @auction/web",
    "verify:web-bidder-auctions": "npm run verify:bidder-auctions --workspace @auction/web",
    "test:e2e": "npm run test:e2e --workspace @auction/web",
    "test:e2e:install": "npm run test:e2e:install --workspace @auction/web",
    "verify:system-e2e": "npm run verify:system-e2e --workspace @auction/web",
    "containers:build": "docker compose --env-file .env.production -f docker-compose.production.yml build",
    "containers:up": "docker compose --env-file .env.production -f docker-compose.production.yml up -d",
    "containers:down": "docker compose --env-file .env.production -f docker-compose.production.yml down",
    "containers:logs": "docker compose --env-file .env.production -f docker-compose.production.yml logs -f",
    "containers:status": "docker compose --env-file .env.production -f docker-compose.production.yml ps",
    "verify:production-containers": "node scripts/verify-production-containers.mjs"
  }
}
