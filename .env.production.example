NODE_ENV=production

# Replace every placeholder before starting the production-like stack.
POSTGRES_USER=replace-with-database-user
POSTGRES_PASSWORD=replace-with-database-password
POSTGRES_DB=auction

# Use a URL-encoded password if the password contains URL-reserved characters.
DATABASE_URL=postgresql://replace-with-database-user:replace-with-database-password@postgres:5432/auction?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

JWT_ACCESS_SECRET=replace-with-strong-random-value-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=auction-api
JWT_AUDIENCE=auction-web

HOST=0.0.0.0
PORT=3000
API_BASE_URL=http://api:3000/api
ALLOWED_APP_ORIGIN=https://replace-with-application-host
