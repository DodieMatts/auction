NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL="postgresql://auction_app:auction_dev_password@127.0.0.1:5433/auction?schema=public"
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Development-only JWT settings.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=auction-api
JWT_AUDIENCE=auction-web

# Development-only seed credentials.
DEV_ADMIN_EMAIL=admin@auction.local
DEV_ADMIN_PASSWORD=AuctionAdmin123!
DEV_BIDDER_EMAIL=bidder@auction.local
DEV_BIDDER_PASSWORD=AuctionBidder123!
